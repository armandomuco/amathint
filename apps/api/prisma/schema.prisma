generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  schoolIdentifier String             @default("local-school")
  schoolId      String             @default("local-school")
  schoolName    String             @default("Local School")
  schoolQark    String?
  studentGrade  Int?
  teacherGrades Int[]              @default([])
  role          String
  passwordHash  String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  conversations ChatConversation[]
  teacherRuns   TeacherAssistantRun[]
  downloadTokens DownloadToken[]

  @@index([schoolId, studentGrade])
  @@index([schoolId, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ChatConversation {
  id        String        @id @default(cuid())
  studentId String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([studentId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  provider       String?
  model          String?
  mathKeyword    String?
  riskLevel      String?
  riskScore      Int?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model TeacherAssistantRun {
  id          String   @id @default(cuid())
  teacherId   String
  requestText String
  lessonId    String?
  provider    String
  status      String
  summary     String?
  jsonPath    String?
  docxPath    String?
  error       String?
  createdAt   DateTime @default(now())
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  downloadTokens DownloadToken[]

  @@index([teacherId])
  @@index([lessonId])
}

model DownloadToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  teacherId String
  runId     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  run       TeacherAssistantRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([runId])
  @@index([expiresAt])
}
