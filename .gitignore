# Node / NestJS
node_modules/
apps/api/prisma/dev.db
apps/api/prisma/dev.db-journal

# Local temporary files
tmp/
temp/
cache/
*.tmp
*.bak

# Generated teacher-facing report artifacts.
# Canonical JSON and indexes are tracked; rendered DOCX files are reproducible.
outputs/amathint_docx/
data/generated/validation_reports/
!legacy/prototype/artifacts/generated_lessons/*.json
!legacy/prototype/artifacts/generated_lessons/README.md

# Old root-level generated/output folders, if recreated.
Materiale_Mesimore/
Materiale_Mesimore_LLM/
Materiale_Mesimore_Matematike/
output/

# Archives produced during handoff/export.
*.zip
*.7z
*.tar.gz
*.rar

# Ignore generated office/document artifacts by default, then explicitly keep
# source curriculum/reference files that are part of the handoff.
*.doc
*.docx
*.pdf
!data/sources/**/*.doc
!data/sources/**/*.docx
!data/sources/**/*.pdf
