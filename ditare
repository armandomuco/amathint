#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if [ -x "$ROOT/.venv/bin/python" ] && "$ROOT/.venv/bin/python" -c 'print("ok")' >/dev/null 2>&1; then
  PYTHON_BIN="$ROOT/.venv/bin/python"
elif [ -x "$ROOT/venv/bin/python" ] && "$ROOT/venv/bin/python" -c 'print("ok")' >/dev/null 2>&1; then
  PYTHON_BIN="$ROOT/venv/bin/python"
fi

echo "Note: ./ditare is a compatibility alias. Prefer ./amathint." >&2
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m ditare.cli "$@"
